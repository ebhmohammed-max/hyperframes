  "cards": [
    {
      "block": 1,
      "at": 4.85,
      "line": "How did the shepherds become dragonlords?",
      "hold": 5.2,
      "sfx": "whoosh-cinematic.mp3"
    },
    {
      "block": 2,
      "at": 0.65,
      "line": "No chronicle gives us the first shepherd's name.",
      "hold": 4.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 2,
      "at": 14.25,
      "line": "First came discovery. Then the struggle to possess it.",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 3,
      "at": 0.85,
      "line": "\u2248 5,000 years before the Conquest",
      "hold": 5.6,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 3,
      "at": 16.65,
      "line": "Beyond those fragile records: the Long Night.",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 4,
      "at": 1.05,
      "line": "A world waiting for the dawn",
      "hold": 5.0,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 5,
      "at": 1.25,
      "line": "The Blood Betrayal",
      "hold": 5.4,
      "sfx": "impact-bass-2.mp3"
    },
    {
      "block": 6,
      "at": 1.65,
      "line": "The continent was not empty.",
      "hold": 5.4,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 7,
      "at": 1.05,
      "line": "Beside the River Ash",
      "hold": 5.0,
      "sfx": "metalLatch.ogg"
    },
    {
      "block": 8,
      "at": 1.05,
      "line": "The harpy and the thunderbolt",
      "hold": 5.0,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 9,
      "at": 1.25,
      "line": "The lockstep legions",
      "hold": 5.2,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 11,
      "at": 0.85,
      "line": "Before the Doom shattered it",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 12,
      "at": 1.05,
      "line": "Ordinary lives beneath extraordinary forces",
      "hold": 5.2,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 14,
      "at": 1.25,
      "line": "Another kind of wealth, under the pasture",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 15,
      "at": 1.05,
      "line": "A country within a country",
      "hold": 5.2,
      "sfx": "impact-bass-2.mp3"
    },
    {
      "block": 16,
      "at": 1.05,
      "line": "Their story began with people, not gods.",
      "hold": 5.2,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 17,
      "at": 1.25,
      "line": "Silver-gold hair, eyes in shades of purple",
      "hold": 5.0,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 20,
      "at": 1.25,
      "line": "A herdsman climbs toward dark rock",
      "hold": 5.4,
      "sfx": "whoosh-cinematic.mp3"
    },
    {
      "block": 22,
      "at": 0.85,
      "line": "A living creature in its own domain",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 24,
      "at": 0.85,
      "line": "A predator they could neither fence out nor handle",
      "hold": 5.0,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 27,
      "at": 1.05,
      "line": "Where had the dragons come from?",
      "hold": 5.2,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 28,
      "at": 1.05,
      "line": "Two moons, and one that cracked like an egg",
      "hold": 5.0,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 29,
      "at": 1.05,
      "line": "Dragon bones far from Valyria",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 31,
      "at": 0.85,
      "line": "The secret did not begin with Valyrian shepherds",
      "hold": 5.4,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 34,
      "at": 1.05,
      "line": "The bond is real. Its origins remain unclear.",
      "hold": 5.2,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 35,
      "at": 1.05,
      "line": "Horns that seem as threatening as they are promising",
      "hold": 4.8,
      "sfx": "metalLatch.ogg"
    },
    {
      "block": 37,
      "at": 1.05,
      "line": "Blood magic, long after the beginnings",
      "hold": 5.0,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 39,
      "at": 1.05,
      "line": "Approach became acceptance.",
      "hold": 5.0,
      "sfx": "whoosh-cinematic.mp3"
    },
    {
      "block": 40,
      "at": 0.85,
      "line": "The wings open. The ledge falls away.",
      "hold": 4.4,
      "sfx": "impact-bass-2.mp3"
    },
    {
      "block": 42,
      "at": 1.05,
      "line": "Families who rode dragons",
      "hold": 5.2,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 44,
      "at": 1.05,
      "line": "Close-kin marriage",
      "hold": 5.2,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 46,
      "at": 1.05,
      "line": "No king. Forty families.",
      "hold": 5.2,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 49,
      "at": 1.05,
      "line": "Forty great dragonlord families",
      "hold": 5.4,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 50,
      "at": 1.05,
      "line": "Far from the greatest of that company",
      "hold": 5.2,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 52,
      "at": 0.85,
      "line": "Arts others could not readily reproduce",
      "hold": 5.2,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 53,
      "at": 1.05,
      "line": "Stone shaped as if it were wax",
      "hold": 4.6,
      "sfx": "cloth1.ogg"
    },
    {
      "block": 56,
      "at": 1.05,
      "line": "Straight, durable, fused stone",
      "hold": 5.0,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 58,
      "at": 1.05,
      "line": "The mines",
      "hold": 5.2,
      "sfx": "impact-bass-2.mp3"
    },
    {
      "block": 60,
      "at": 1.05,
      "line": "Some rose into the sky. Others were driven underground.",
      "hold": 5.6,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 62,
      "at": 0.85,
      "line": "Both built their greatness through conquest and slavery",
      "hold": 5.4,
      "sfx": "whoosh-short.mp3"
    },
    {
      "block": 64,
      "at": 0.85,
      "line": "The lockstep legion beside the dragonrider",
      "hold": 5.0,
      "sfx": "impact-bass-1.mp3"
    },
    {
      "block": 68,
      "at": 1.25,
      "line": "Not a simple ascent from weakness into glory",
      "hold": 5.4,
      "sfx": "whoosh-cinematic.mp3"
    },
    {
      "block": 70,
      "at": 5.85,
      "line": "The shepherds had become dragonlords.",
      "hold": 8.0,
      "sfx": "whoosh-cinematic.mp3"
    }
  ],
